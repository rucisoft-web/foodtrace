<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_wizard_form" model="ir.ui.view">
        <field name="name">wms.tally.wizard.form</field>
        <field name="model">wms.tally.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="picking_id" invisible="1"/>
                <div class="alert alert-info" role="status" invisible="not message"><field name="message"/></div>
                <group>
                    <group>
                        <field name="move_id" options="{'no_create': True}"/>
                        <field name="barcode" placeholder="Scan barcode karton lalu tekan Tambah" default_focus="1"/>
                    </group>
                    <group string="Bila barcode gagal dibaca">
                        <field name="manual_weight"/>
                        <field name="manual_lot"/>
                        <field name="manual_expiry"/>
                    </group>
                </group>
                <button name="action_scan" type="object" string="Tambah karton" class="btn-secondary"/>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="carton_no"/>
                        <field name="weight_kg" sum="Total"/>
                        <field name="lot_name"/>
                        <field name="expiry"/>
                        <field name="template_id"/>
                        <field name="manual"/>
                    </list>
                </field>
                <group>
                    <field name="carton_count"/>
                    <field name="total_weight"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Simpan ke penerimaan" class="btn-primary"/>
                    <button special="cancel" string="Batal"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

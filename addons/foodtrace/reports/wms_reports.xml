<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_lpn_label" model="report.paperformat">
        <field name="name">Label LPN 150x100</field>
        <field name="format">custom</field>
        <field name="page_height">100</field>
        <field name="page_width">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_lpn_label" model="ir.actions.report">
        <field name="name">Label LPN</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">foodtrace.report_lpn_label</field>
        <field name="report_file">foodtrace.report_lpn_label</field>
        <field name="print_report_name">'LPN-%s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_lpn_label"/>
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="action_report_manifest" model="ir.actions.report">
        <field name="name">Manifest muat</field>
        <field name="model">wms.loading</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">foodtrace.report_manifest</field>
        <field name="report_file">foodtrace.report_manifest</field>
        <field name="print_report_name">'Manifest-%s' % object.name</field>
        <field name="binding_model_id" ref="model_wms_loading"/>
    </record>
    <record id="action_report_surat_jalan" model="ir.actions.report">
        <field name="name">Surat jalan</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">foodtrace.report_surat_jalan</field>
        <field name="report_file">foodtrace.report_surat_jalan</field>
        <field name="print_report_name">'SJ-%s' % object.name</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

    <!-- Label LPN mengikuti format Largo: kiri info palet + QR LPN, kanan stiker QR kecil untuk karton. -->
    <template id="report_lpn_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="pack">
                <t t-set="d" t-value="pack._wms_label_data()"/>
                <t t-set="qr" t-value="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=300&amp;height=300' % pack.name"/>
                <div class="page" style="font-family: Arial, sans-serif; page-break-after: always; color: #000;">
                    <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                        <tr>
                            <td style="width: 52%; vertical-align: top; padding-right: 2mm; border-right: 0.6mm solid #000;">
                                <div style="font-size: 6.5pt; white-space: nowrap;">
                                    <b>Printed By :</b> <t t-esc="d['printed_by']"/>
                                    <span style="padding-left: 2mm;"><b>Printed On :</b> <t t-esc="d['printed_on']"/></span>
                                </div>
                                <div style="font-size: 13pt; font-weight: bold; margin-top: 1mm;" t-esc="d['code']"/>
                                <div style="font-size: 11pt; font-weight: bold; border-bottom: 0.6mm solid #000; padding-bottom: 1mm;" t-esc="d['name']"/>
                                <table style="width: 100%; border-collapse: collapse; margin-top: 1mm;">
                                    <tr>
                                        <td style="width: 40%; border: 0.5mm solid #000; text-align: center; padding: 1mm;">
                                            <img t-att-src="qr" style="width: 25mm; height: 25mm;"/>
                                            <div style="font-size: 8pt;">LPN-<t t-esc="pack.name"/></div>
                                        </td>
                                        <td style="vertical-align: middle; padding-left: 2mm; font-size: 11pt; font-weight: bold; line-height: 1.6;">
                                            <div>Exp : <t t-esc="d['exp']"/></div>
                                            <div>Rcv : <t t-esc="d['rcv']"/></div>
                                            <div>Pack : <t t-esc="d['pack']"/></div>
                                        </td>
                                    </tr>
                                </table>
                                <table style="width: 100%; font-size: 9.5pt; margin-top: 1.5mm; line-height: 1.45;">
                                    <tr><td style="width: 42%;"><b>Qty Tally/Karton</b></td>
                                        <td>: <b><t t-esc="d['qty']"/></b> <t t-esc="d['uom']"/> / <b><t t-esc="d['cartons']"/></b></td></tr>
                                    <tr><td><b>Lot</b></td><td>: <t t-esc="d['lot']"/></td></tr>
                                    <tr><td><b>EST</b></td><td>: <t t-esc="d['est']"/></td></tr>
                                    <tr><td><b>No. Pallet</b></td><td>: <t t-esc="d['pallet']"/></td></tr>
                                    <tr><td><b>No Container</b></td><td>: <t t-esc="d['container']"/></td></tr>
                                    <tr><td><b>Packaging</b></td><td>: <t t-esc="d['packaging']"/></td></tr>
                                    <tr><td><b>Grade</b></td><td>: <t t-esc="d['grade']"/>
                                        <span t-if="d['zone']" style="float: right; border: 0.4mm solid #000; padding: 0 1.5mm;" t-esc="d['zone']"/></td></tr>
                                </table>
                            </td>
                            <td style="vertical-align: top; padding-left: 1.5mm;">
                                <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                                    <t t-foreach="range(d['stickers'] // 4)" t-as="row">
                                        <tr>
                                            <t t-foreach="range(4)" t-as="col">
                                                <td style="height: 15.2mm; text-align: center; border: 0.2mm dashed #999; padding: 0.5mm;">
                                                    <img t-att-src="qr" style="width: 11mm; height: 11mm;"/>
                                                    <div style="font-size: 5pt;" t-esc="pack.name"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_manifest">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="job">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Manifest muat <t t-esc="job.name"/></h3>
                        <div class="row mb-3">
                            <div class="col-4"><b>Tanggal:</b> <span t-field="job.date"/></div>
                            <div class="col-4"><b>Kendaraan:</b> <span t-esc="job.vehicle_plate"/></div>
                            <div class="col-4"><b>Pengemudi:</b> <span t-esc="job.driver"/></div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Outbound</th><th>Customer</th><th>Item</th><th>Lot</th><th>Expiry</th>
                                    <th>LPN</th><th class="text-end">Qty</th><th>Muat</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="job.picking_ids" t-as="p">
                                    <tr t-foreach="p.move_line_ids" t-as="ml">
                                        <td t-esc="p.name"/>
                                        <td t-esc="p.partner_id.name"/>
                                        <td><t t-esc="ml.product_id.default_code"/> <t t-esc="ml.product_id.name"/></td>
                                        <td t-esc="ml.lot_id.name"/>
                                        <td t-esc="ml.lot_id.expiration_date and ml.lot_id.expiration_date.strftime('%d-%m-%Y')"/>
                                        <td t-esc="(ml.result_package_id or ml.package_id).name"/>
                                        <td class="text-end"><t t-esc="'%g' % ml.quantity"/> <t t-esc="ml.product_uom_id.name"/></td>
                                        <td t-esc="ml.wms_loaded and '✓' or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p><b>Total berat:</b> <t t-esc="'%.2f' % job.total_weight"/> kg ·
                           <b>Baris dimuat:</b> <t t-esc="job.loaded_count"/>/<t t-esc="job.line_count"/></p>
                        <div class="row mt-5">
                            <div class="col-4 text-center">Checker<br/><br/><br/>(.................)</div>
                            <div class="col-4 text-center">Pengemudi<br/><br/><br/>(.................)</div>
                            <div class="col-4 text-center">Kepala gudang<br/><br/><br/>(.................)</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_surat_jalan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="p">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-8">
                                <h3>Surat jalan <t t-esc="p.wms_delivery_note or p.name"/></h3>
                                <div><b>Kepada:</b> <span t-field="p.partner_id"
                                     t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/></div>
                                <div><b>Ref. SO:</b> <t t-esc="p.origin"/> · <b>Rute:</b> <t t-esc="p.wms_shipping_group"/></div>
                                <div><b>Kendaraan:</b> <t t-esc="p.wms_loading_id.vehicle_plate"/> ·
                                     <b>Pengemudi:</b> <t t-esc="p.wms_loading_id.driver"/></div>
                            </div>
                            <div class="col-4 text-end" t-if="p.wms_pod_id">
                                <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=160&amp;height=160' % p.wms_pod_id.get_url()"
                                     style="width: 32mm; height: 32mm;"/>
                                <div style="font-size: 10px;">Scan untuk POD (suhu, qty diterima, foto)</div>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered mt-3">
                            <thead><tr><th>Item</th><th>Lot</th><th>Expiry</th><th class="text-end">Qty</th><th>Satuan</th></tr></thead>
                            <tbody>
                                <tr t-foreach="p.move_line_ids" t-as="ml">
                                    <td><t t-esc="ml.product_id.default_code"/> <t t-esc="ml.product_id.name"/></td>
                                    <td t-esc="ml.lot_id.name"/>
                                    <td t-esc="ml.lot_id.expiration_date and ml.lot_id.expiration_date.strftime('%d-%m-%Y')"/>
                                    <td class="text-end" t-esc="'%g' % ml.quantity"/>
                                    <td t-esc="ml.product_uom_id.name"/>
                                </tr>
                            </tbody>
                        </table>
                        <p>Suhu saat diterima: ........ °C (frozen ≤ -17 °C, chilled ≤ -1 °C)</p>
                        <div class="row mt-5">
                            <div class="col-4 text-center">Gudang<br/><br/><br/>(.................)</div>
                            <div class="col-4 text-center">Pengemudi<br/><br/><br/>(.................)</div>
                            <div class="col-4 text-center">Penerima<br/><br/><br/>(.................)</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wms" model="ir.module.category">
        <field name="name">FoodTrace</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_wms_operator" model="res.groups">
        <field name="name">Operator gudang</field>
        <field name="category_id" ref="module_category_wms"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_wms_manager" model="res.groups">
        <field name="name">Kepala gudang / QA</field>
        <field name="category_id" ref="module_category_wms"/>
        <field name="implied_ids" eval="[(4, ref('group_wms_operator')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_temp_company" model="ir.rule">
        <field name="name">Log suhu: perusahaan</field>
        <field name="model_id" ref="model_wms_temperature_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_carton_company" model="ir.rule">
        <field name="name">Karton: perusahaan</field>
        <field name="model_id" ref="model_wms_carton"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sap_company" model="ir.rule">
        <field name="name">Antrean SAP: perusahaan</field>
        <field name="model_id" ref="model_wms_sap_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sync_company" model="ir.rule">
        <field name="name">Sinkron SAP: perusahaan</field>
        <field name="model_id" ref="model_wms_sync_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wms_loading_company" model="ir.rule">
        <field name="name">Loading job: perusahaan</field>
        <field name="model_id" ref="model_wms_loading"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wms_pod_company" model="ir.rule">
        <field name="name">POD: perusahaan</field>
        <field name="model_id" ref="model_wms_pod"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wms_inventory_check_company" model="ir.rule">
        <field name="name">Inventory check: perusahaan</field>
        <field name="model_id" ref="model_wms_inventory_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_wms_butcher_company" model="ir.rule">
        <field name="name">Butcher: perusahaan</field>
        <field name="model_id" ref="model_wms_butcher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_check_list" model="ir.ui.view">
        <field name="name">wms.inventory.check.list</field>
        <field name="model">wms.inventory.check</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'submitted'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="mode"/>
                <field name="location_id"/>
                <field name="package_id"/>
                <field name="user_id"/>
                <field name="difference_count"/>
                <field name="reprint_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_inventory_check_form" model="ir.ui.view">
        <field name="name">wms.inventory.check.form</field>
        <field name="model">wms.inventory.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load" type="object" string="Ambil stok sistem" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Kirim untuk approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="foodtrace.group_wms_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'" groups="foodtrace.group_wms_manager"/>
                    <button name="action_reset" type="object" string="Kembali ke draft" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="mode" widget="radio" readonly="state != 'draft'"/>
                            <field name="location_id" invisible="mode != 'location'" readonly="state != 'draft'"/>
                            <field name="package_id" invisible="mode != 'lpn'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="approved_by"/>
                            <field name="difference_count"/>
                            <field name="reprint_count"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" decoration-danger="is_difference">
                            <field name="location_id"/>
                            <field name="package_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="qty_before"/>
                            <field name="qty_after"/>
                            <field name="difference"/>
                            <field name="expiry_before"/>
                            <field name="expiry_after"/>
                            <field name="is_difference" column_invisible="1"/>
                            <field name="need_reprint"/>
                            <field name="remark"/>
                        </list>
                    </field>
                    <field name="remark" placeholder="Catatan"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_inventory_check_search" model="ir.ui.view">
        <field name="name">wms.inventory.check.search</field>
        <field name="model">wms.inventory.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location_id"/>
                <field name="package_id"/>
                <filter name="to_approve" string="Menunggu approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="with_diff" string="Ada selisih" domain="[('difference_count', '>', 0)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_mode" string="Jenis" context="{'group_by': 'mode'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_inventory_check" model="ir.actions.act_window">
        <field name="name">Inventory Check</field>
        <field name="res_model">wms.inventory.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_inventory_check_approval" model="ir.actions.act_window">
        <field name="name">Inventory Check Approval</field>
        <field name="res_model">wms.inventory.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
    <record id="view_inventory_check_line_list" model="ir.ui.view">
        <field name="name">wms.inventory.check.line.list</field>
        <field name="model">wms.inventory.check.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="is_difference">
                <field name="check_id"/>
                <field name="location_id"/>
                <field name="package_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="qty_before"/>
                <field name="qty_after"/>
                <field name="difference" sum="Selisih"/>
                <field name="expiry_before"/>
                <field name="expiry_after"/>
                <field name="is_difference" column_invisible="1"/>
                <field name="need_reprint"/>
            </list>
        </field>
    </record>
    <record id="action_inventory_check_report" model="ir.actions.act_window">
        <field name="name">Inventory Check Discrepancy</field>
        <field name="res_model">wms.inventory.check.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('is_difference', '=', True)]</field>
        <field name="context">{'group_by': ['product_id']}</field>
    </record>

    <!-- LPN: tutup palet, cetak ulang label -->
    <record id="view_package_form_wms_label" model="ir.ui.view">
        <field name="name">stock.quant.package.form.wms.label</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_wms_print_label" type="object" string="Cetak label LPN" class="btn-primary"/>
            </xpath>
            <field name="package_type_id" position="after">
                <field name="wms_closed"/>
                <field name="wms_need_reprint"/>
            </field>
        </field>
    </record>
    <record id="action_lpn_reprint" model="ir.actions.act_window">
        <field name="name">Need to Print (LPN)</field>
        <field name="res_model">stock.quant.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('wms_need_reprint', '=', True)]</field>
    </record>
    <record id="action_server_print_lpn" model="ir.actions.server">
        <field name="name">Cetak label LPN</field>
        <field name="model_id" ref="stock.model_stock_quant_package"/>
        <field name="binding_model_id" ref="stock.model_stock_quant_package"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_wms_print_label()</field>
    </record>

    <!-- Butcher -->
    <record id="view_butcher_list" model="ir.ui.view">
        <field name="name">wms.butcher.list</field>
        <field name="model">wms.butcher</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="kind"/>
                <field name="ref"/>
                <field name="source_id"/>
                <field name="total_kg" sum="Total"/>
                <field name="yield_pct"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_butcher_form" model="ir.ui.view">
        <field name="name">wms.butcher.form</field>
        <field name="model">wms.butcher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Selesai" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_labels" type="object" string="Cetak label LPN hasil"
                            invisible="state != 'done' or kind != 'in'"/>
                    <button name="action_cancel" type="object" string="Batal" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="ref" readonly="state != 'draft'"/>
                            <field name="source_id" invisible="kind != 'in'" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="total_kg"/>
                            <field name="yield_pct"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="kind" column_invisible="1"/>
                            <field name="process_type" column_invisible="parent.kind != 'in'"/>
                            <field name="package_id" string="LPN" readonly="parent.kind == 'in'"/>
                            <field name="product_id"/>
                            <field name="lot_id" column_invisible="parent.kind != 'out'"/>
                            <field name="lot_name" column_invisible="parent.kind != 'in'"/>
                            <field name="location_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="qty_kg"/>
                            <field name="grade" column_invisible="parent.kind != 'in'"/>
                            <field name="brand" column_invisible="parent.kind != 'in'"/>
                            <field name="cutting_type" column_invisible="parent.kind != 'in'"/>
                            <field name="expiration_date" column_invisible="parent.kind != 'in'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_butcher_out" model="ir.actions.act_window">
        <field name="name">Butcher Out</field>
        <field name="res_model">wms.butcher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'out')]</field>
        <field name="context">{'default_kind': 'out'}</field>
    </record>
    <record id="action_butcher_in" model="ir.actions.act_window">
        <field name="name">Butcher In / Repack</field>
        <field name="res_model">wms.butcher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'in')]</field>
        <field name="context">{'default_kind': 'in'}</field>
    </record>
</odoo>

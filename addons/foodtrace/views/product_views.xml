<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_wms" model="ir.ui.view">
        <field name="name">product.template.form.wms</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="FoodTrace" name="wms">
                    <group>
                        <group string="Penyimpanan">
                            <field name="wms_zone"/>
                            <field name="wms_catch_weight"/>
                            <field name="wms_min_receive_life_pct"/>
                            <field name="wms_barcode_template_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Data SAP B1">
                            <field name="wms_item_group"/>
                            <field name="wms_sub_group"/>
                            <field name="wms_country"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_list_wms" model="ir.ui.view">
        <field name="name">product.template.list.wms</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="wms_zone" optional="show"/>
                <field name="wms_item_group" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="product_template_search_wms" model="ir.ui.view">
        <field name="name">product.template.search.wms</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter name="wms_frozen" string="Frozen" domain="[('wms_zone', '=', 'frozen')]"/>
                <filter name="wms_chilled" string="Chilled" domain="[('wms_zone', '=', 'chilled')]"/>
                <filter name="wms_dry" string="Dry" domain="[('wms_zone', '=', 'dry')]"/>
                <filter name="wms_nozone" string="Belum ada zona" domain="[('wms_zone', '=', False), ('is_storable', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
    <record id="action_product_wms" model="ir.actions.act_window">
        <field name="name">Item</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_storable', '=', True)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_barcode_template_list" model="ir.ui.view">
        <field name="name">wms.barcode.template.list</field>
        <field name="model">wms.barcode.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="weight_unit"/>
                <field name="sample"/>
            </list>
        </field>
    </record>
    <record id="view_barcode_template_form" model="ir.ui.view">
        <field name="name">wms.barcode.template.form</field>
        <field name="model">wms.barcode.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_sample" type="object" string="Uji contoh barcode" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="pattern" invisible="kind != 'regex'" required="kind == 'regex'"/>
                            <field name="weight_unit"/>
                            <field name="weight_decimals" invisible="kind != 'regex'"/>
                        </group>
                        <group>
                            <field name="min_weight"/>
                            <field name="max_weight"/>
                            <field name="sample"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="product_tmpl_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_barcode_template" model="ir.actions.act_window">
        <field name="name">Template barcode karton</field>
        <field name="res_model">wms.barcode.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

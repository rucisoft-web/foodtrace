<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_temperature_log_list" model="ir.ui.view">
        <field name="name">wms.temperature.log.list</field>
        <field name="model">wms.temperature.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_alarm" decoration-muted="state == 'done' and not is_alarm">
                <field name="date"/>
                <field name="zone"/>
                <field name="location_id"/>
                <field name="source"/>
                <field name="temperature"/>
                <field name="target_temp" optional="show"/>
                <field name="alarm_temp" optional="show"/>
                <field name="humidity" optional="hide"/>
                <field name="picking_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="is_alarm"/>
                <field name="state" widget="badge" decoration-danger="state == 'open'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_temperature_log_form" model="ir.ui.view">
        <field name="name">wms.temperature.log.form</field>
        <field name="model">wms.temperature.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Tindak lanjut selesai" class="btn-primary"
                            invisible="state != 'open'" groups="foodtrace.group_wms_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not is_alarm">
                        Suhu di atas batas alarm. Stok terkait ditinjau QC.
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="zone"/>
                            <field name="location_id"/>
                            <field name="source"/>
                            <field name="picking_id"/>
                        </group>
                        <group>
                            <field name="temperature"/>
                            <field name="humidity"/>
                            <field name="target_temp"/>
                            <field name="alarm_temp"/>
                            <field name="is_alarm"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Catatan, mis. pintu cold room terbuka saat bongkar"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_temperature_log_search" model="ir.ui.view">
        <field name="name">wms.temperature.log.search</field>
        <field name="model">wms.temperature.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="location_id"/>
                <field name="picking_id"/>
                <filter name="alarm" string="Alarm" domain="[('is_alarm', '=', True)]"/>
                <filter name="open" string="Perlu tindak lanjut" domain="[('state', '=', 'open')]"/>
                <separator/>
                <filter name="room" string="Ruang" domain="[('source', 'in', ('manual', 'sensor'))]"/>
                <filter name="doc" string="Penerimaan/pengiriman" domain="[('source', 'in', ('receipt', 'truck', 'delivery'))]"/>
                <filter name="last7" string="7 hari terakhir"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Kelompok">
                    <filter name="g_zone" string="Zona" context="{'group_by': 'zone'}"/>
                    <filter name="g_day" string="Hari" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_temperature_log_graph" model="ir.ui.view">
        <field name="name">wms.temperature.log.graph</field>
        <field name="model">wms.temperature.log</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="date" interval="day"/>
                <field name="zone"/>
                <field name="temperature" type="measure" operator="avg"/>
            </graph>
        </field>
    </record>
    <record id="action_temperature_log" model="ir.actions.act_window">
        <field name="name">Log suhu</field>
        <field name="res_model">wms.temperature.log</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_last7': 1}</field>
    </record>
</odoo>
